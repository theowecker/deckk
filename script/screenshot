#!/usr/bin/env bash
# Regenerates docs/screenshot.png from demo data. Needs Google Chrome.
set -euo pipefail
cd "$(dirname "$0")/.."
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

DECKK_SCREENSHOT="$tmp/shot.html" go test ./internal/ui -run TestScreenshot -count=1 >/dev/null
# Headless Chrome sometimes never exits after writing the image.
perl -e 'alarm 60; exec @ARGV' "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless=new --disable-gpu --mute-audio \
  --hide-scrollbars --default-background-color=00000000 --force-device-scale-factor=2 \
  --virtual-time-budget=5000 --user-data-dir="$tmp/chrome" --window-size="${1:-1072},${2:-620}" \
  --screenshot="${OUT:-$PWD/docs/screenshot.png}" "file://$tmp/shot.html" >/dev/null 2>&1
echo "wrote ${OUT:-docs/screenshot.png}"
